# stat.service — локальный планер (Docker)

# Имя приложения в интерфейсе
VITE_APP_NAME=stat.service

# Первый администратор (создаётся при первом запуске в браузере, если БД пуста)
VITE_SEED_ADMIN_EMAIL=admin@local
VITE_SEED_ADMIN_PASSWORD=change-me

# Разрешить самостоятельную регистрацию на /register (true/false)
VITE_ALLOW_PUBLIC_REGISTER=false

# Секрет для JWT-сессий API (обязательно смените в production)
JWT_SECRET=change-me-in-production

# Базовый URL API для фронтенда (в Docker обычно /api)
VITE_API_BASE=/api
